{
  "name": "dbly",
  "displayName": "dbly",
  "description": "A small PostgreSQL and BigQuery query runner for SQL files.",
  "version": "0.0.1",
  "publisher": "chris",
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbly.selectConnection",
        "title": "dbly: Select Connection"
      },
      {
        "command": "dbly.setPassword",
        "title": "dbly: Set Connection Password"
      },
      {
        "command": "dbly.reconnect",
        "title": "dbly: Reconnect"
      },
      {
        "command": "dbly.runStatement",
        "title": "dbly: Run Current Statement"
      }
    ],
    "keybindings": [
      {
        "command": "dbly.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node esbuild.mjs",
    "test": "tsx --test src/statement.test.ts src/connectionComment.test.ts src/csv.test.ts src/bigqueryValues.test.ts src/postgresSessions.test.ts",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.0.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/vscode": "^1.101.0",
    "big.js": "^7.0.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
